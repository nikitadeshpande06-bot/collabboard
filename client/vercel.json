{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE_WITH_YOUR_RAILWAY_URL/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://REPLACE_WITH_YOUR_RAILWAY_URL/socket.io/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
