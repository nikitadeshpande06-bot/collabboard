{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "echo skip",
  "build": {
    "env": {
      "VITE_API_URL": "/api",
      "VITE_SOCKET_URL": "https://collabboard-production-933a.up.railway.app"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://collabboard-production-933a.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
